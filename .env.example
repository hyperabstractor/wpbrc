# Copy to .env for local runs, or set these in Coolify.

# First-run only: seeds the first admin in data/users.json.
# After that, add editors at /admin/users (do not put new people in env).
CMS_USER=admin
CMS_PASSWORD=change-me

SESSION_SECRET=change-me-to-a-long-random-string

# 1 on Coolify (HTTPS in front of the container). 0 for local http://localhost.
CMS_HTTPS=0
